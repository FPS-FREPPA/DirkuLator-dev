DirkuLator 0.66rc: the game's music plays. A voice that loops a wave buffer for ever (loop_count < 0) is counted;
with /data/eden-nx2/music-off.txt (main.cpp sets EDEN_NX2_MUSIC_OFF) its output is silenced as in 0.60rc to 0.65rc.
EDEN_MUSIC_PLAYING / EDEN_MUSIC_MUTED log the first and every doubling of those voice updates.
Ambient loops are counted with the music.

diff --git a/src/audio_core/renderer/command/data_source/decode.cpp b/src/audio_core/renderer/command/data_source/decode.cpp
--- a/src/audio_core/renderer/command/data_source/decode.cpp
+++ b/src/audio_core/renderer/command/data_source/decode.cpp
@@ -8,6 +8,8 @@
 #include <atomic>
 #include <chrono>
 #include <cstdio>
+#include <cstdlib>
+#include <cstring>
 #include <vector>
 
 #include "audio_core/renderer/command/data_source/decode.h"
@@ -268,6 +270,14 @@
         }
     }
 #endif
+#ifdef EDEN_NX2_PS5_PROTO
+    // DirkuLator 0.66rc: music plays; a voice looping a wave buffer for ever (loop_count < 0) is
+    // counted and logged. /data/eden-nx2/music-off.txt silences its output, decoded as before so
+    // voice state and timing do not change (the 0.60rc to 0.65rc behaviour).
+    static const bool music_on = std::getenv("EDEN_NX2_MUSIC_OFF") == nullptr;
+    static std::atomic<u64> music_muted{};
+    bool music_voice = false;
+#endif
     auto wavebuffers_consumed{voice_state.wave_buffers_consumed};
     auto wavebuffer_index{voice_state.wave_buffer_index};
     auto played_sample_count{voice_state.played_sample_count};
@@ -310,6 +320,11 @@
             }
 
             auto& wavebuffer = args.wave_buffers[wavebuffer_index];
+#ifdef EDEN_NX2_PS5_PROTO
+            if (wavebuffer.loop && wavebuffer.loop_count < 0) {
+                music_voice = true;
+            }
+#endif
             if (offset == 0 && args.sample_format == SampleFormat::Adpcm && wavebuffer.context != 0) {
                 memory.ReadBlockUnsafe(wavebuffer.context, &voice_state.adpcm_context, wavebuffer.context_size);
             }
@@ -423,6 +438,16 @@
         output_buffer = output_buffer.subspan(samples_to_write);
     }
 
+#ifdef EDEN_NX2_PS5_PROTO
+    if (music_voice) {
+        if (!music_on) std::memset(args.output.data(), 0, args.output.size_bytes());
+        const u64 counted = music_muted.fetch_add(1, std::memory_order_relaxed) + 1;
+        if ((counted & (counted - 1)) == 0) {
+            std::fprintf(stderr, "EDEN_MUSIC_%s voice updates=%llu (music-off.txt mutes it)\n",
+                         music_on ? "PLAYING" : "MUTED", static_cast<unsigned long long>(counted));
+        }
+    }
+#endif
     voice_state.wave_buffers_consumed = wavebuffers_consumed;
     voice_state.played_sample_count = played_sample_count;
     voice_state.wave_buffer_index = wavebuffer_index;
