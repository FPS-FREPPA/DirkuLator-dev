+#ifdef EDEN_NX2_PS5_PROTO
+// 0.77rc EDEN_AUDIO_VOICES: per five seconds, averaged over the renders: voices in use, voices the game has started, started
+// voices with no wave buffer left (an underrun: the game did not refill them in time) and voices commanded to decode.
+static std::atomic<u64> g_vs_renders{0}, g_vs_in_use{0}, g_vs_started{0}, g_vs_underrun{0}, g_vs_commanded{0},
+    g_vs_max_started{0};
+static std::atomic<s64> g_vs_next{0};
+#endif
+
 void CommandGenerator::GenerateVoiceCommands() {
     const auto voice_count{voice_context.GetCount()};
+#ifdef EDEN_NX2_PS5_PROTO
+    u64 probe_in_use = 0, probe_started = 0, probe_underrun = 0, probe_commanded = 0;
+#endif
 
     for (u32 i = 0; i < voice_count; i++) {
         auto sorted_info{voice_context.GetSortedInfo(i)};
 
+#ifdef EDEN_NX2_PS5_PROTO
+        if (sorted_info->in_use) {
+            ++probe_in_use;
+            if (sorted_info->current_play_state == VoiceInfo::ServerPlayState::Started) {
+                ++probe_started;
+                if (sorted_info->wave_buffer_count == 0) ++probe_underrun;
+            }
+        }
+#endif
         if (sorted_info->ShouldSkip() || !sorted_info->UpdateForCommandGeneration(voice_context)) {
             continue;
         }
+#ifdef EDEN_NX2_PS5_PROTO
+        ++probe_commanded;
+#endif
 
         EntryAspect voice_entry_aspect(*this, PerformanceEntryType::Voice, sorted_info->node_id);
 
@@ -297,6 +320,32 @@
     }
 
     splitter_context.UpdateInternalState();
+#ifdef EDEN_NX2_PS5_PROTO
+    {
+        g_vs_renders.fetch_add(1, std::memory_order_relaxed);
+        g_vs_in_use.fetch_add(probe_in_use, std::memory_order_relaxed);
+        g_vs_started.fetch_add(probe_started, std::memory_order_relaxed);
+        g_vs_underrun.fetch_add(probe_underrun, std::memory_order_relaxed);
+        g_vs_commanded.fetch_add(probe_commanded, std::memory_order_relaxed);
+        u64 seen = g_vs_max_started.load(std::memory_order_relaxed);
+        while (probe_started > seen &&
+               !g_vs_max_started.compare_exchange_weak(seen, probe_started, std::memory_order_relaxed)) {}
+        const s64 now = std::chrono::duration_cast<std::chrono::seconds>(
+                            std::chrono::steady_clock::now().time_since_epoch()).count();
+        if (s64 next = g_vs_next.load(std::memory_order_relaxed);
+            now >= next && g_vs_next.compare_exchange_strong(next, now + 5)) {
+            const u64 renders = (std::max<u64>)(g_vs_renders.exchange(0, std::memory_order_relaxed), 1);
+            std::fprintf(stderr,
+                         "EDEN_AUDIO_VOICES renders=%llu in_use_avg=%.1f started_avg=%.1f started_max=%llu underrun_avg=%.2f commanded_avg=%.1f\n",
+                         static_cast<unsigned long long>(renders),
+                         g_vs_in_use.exchange(0, std::memory_order_relaxed) / double(renders),
+                         g_vs_started.exchange(0, std::memory_order_relaxed) / double(renders),
+                         static_cast<unsigned long long>(g_vs_max_started.exchange(0, std::memory_order_relaxed)),
+                         g_vs_underrun.exchange(0, std::memory_order_relaxed) / double(renders),
+                         g_vs_commanded.exchange(0, std::memory_order_relaxed) / double(renders));
+        }
+    }
+#endif
 }
 
