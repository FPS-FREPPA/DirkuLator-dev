+/// Whether bindless texture handles may hold the texture header's byte offset in the pool (index * 32) where a handle
+/// normally has the index. Only Nintendo Switch Sports Resort is known to use them. Ocarina of Time has an out-of-range
+/// handle (0xbe000 = 778240) that, read as an offset, would land on header 24320, a slot the game reuses for render
+/// targets, and its wall trims then flash with whatever image is there (Eglantine pull request 900).
+[[nodiscard]] bool UsesHeaderByteOffsetHandles(bool native_tiling);
+
+/// The header index a texture handle's index stands for. Read as a byte offset only when byte_offsets
+/// (UsesHeaderByteOffsetHandles), the plain index falls past the pool and the offset lands inside it, so handles that
+/// already resolve are left alone and an out-of-range one stays out of range (it then reads as no texture).
+[[nodiscard]] constexpr u32 TextureHeaderIndex(u32 index, u32 limit, bool byte_offsets) {
+    if (byte_offsets && index > limit && index % 32 == 0 && index / 32 <= limit) {
+        return index / 32;
+    }
+    return index;
+}
+static_assert(TextureHeaderIndex(778240, 30000, false) == 778240, "an out-of-range handle stays out of range");
+static_assert(TextureHeaderIndex(778240, 30000, true) == 24320, "byte offset 778240 is header 24320");
+static_assert(TextureHeaderIndex(100, 30000, true) == 100, "an index that resolves is left alone");
+static_assert(TextureHeaderIndex(33, 10, true) == 33, "only multiples of 32 are offsets");
+static_assert(TextureHeaderIndex(64000, 1000, true) == 64000, "an offset that lands outside the pool is not one");
+
